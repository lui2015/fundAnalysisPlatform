# ============ 服务 ============
PORT=3250
NODE_ENV=development
TZ=Asia/Shanghai
# 子路径部署时填写对外基址，用于分享链接（例：https://www.luliming.xyz/fundAnalysis）
PUBLIC_BASE_URL=

# ============ 大模型（混元 hy3，OpenAI 兼容协议） ============
# 密钥仅存于环境变量，禁止写入代码库（安全要求 S-2）
HUNYUAN_API_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy3
HUNYUAN_TIMEOUT_MS=45000
AI_MAX_RETRY=1
# 六板块并行的并发上限；网关并发不足时下调（对应 PRD F3-3）
AI_CONCURRENCY=3
# 合并策略：none=五板块各调一次(共6次) / merge=合并为4次
AI_MERGE_STRATEGY=none
DAILY_MODEL_CALL_BUDGET=2000

# ============ 数据 ============
DATA_DIR=./data
# auto=真实源失败回退演示数据并标注 / live=只用真实源 / mock=纯离线演示
DATA_MODE=auto
HTTP_TIMEOUT_MS=9000

# ============ 限流配额 ============
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
# 同一基金同一净值日的报告复用窗口（毫秒）
REPORT_REUSE_MS=600000
